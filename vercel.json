{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!styles\\.css|assets/).*)",
      "missing": [{ "type": "query", "key": "utm_source" }],
      "destination": "https://tienda.cencocal.cl/home",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
